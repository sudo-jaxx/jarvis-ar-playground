{
  "name": "jarvis-ar-playground",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{"name":"ROOMS","class_name":"PlaygroundRoom"}] },
  "migrations": [{"tag":"v1","new_sqlite_classes":["PlaygroundRoom"]}]
}
